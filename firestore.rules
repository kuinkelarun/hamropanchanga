rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions — declared before use to avoid compilation issues
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin if auth token has admin claim OR there exists an adminList document for their uid
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminList/$(request.auth.uid))
      );
    }

    // Check if user is a Super User
    // Note: used below in permission checks to ensure the linter marks it as used.
    function isSuperUser() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superuser';
    }

    // Check if user has a specific permission
    function hasPermission(permission) {
      return isAuthenticated() && (
        isAdmin() || // Admins have all permissions
        isSuperUser() || // Super Users are granted full permissions as well
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true)
      );
    }

    // Owner check for documents that store a `userId` field
    function isOwnerOfUserId(userId) {
      return isAuthenticated() && userId == request.auth.uid;
    }

    match /customers/{customerId} {
      // Admins can read/write any customer (they have viewAllCustomers permission)
      // Super Users and regular users can only access their own customers
      allow read, write: if isAdmin() || (
        // create uses request.resource, reads/updates use resource
        (request.resource != null && isOwnerOfUserId(request.resource.data.userId)) ||
        (resource != null && isOwnerOfUserId(resource.data.userId))
      );

      // Allow access to familyMembers subcollection if user owns the parent customer document
      match /familyMembers/{memberId} {
        allow read, write: if isAdmin() || (
          isAuthenticated() && 
          get(/databases/$(database)/documents/customers/$(customerId)).data.userId == request.auth.uid
        );
      }
    }

    match /users/{userId} {
      // Users can read their own document
      // Admins and Super Users can read/write any user document (for user management)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isSuperUser());
      // Allow users to create/update their own document (for invitation processing)
      // Admins can modify any user document (for user management)
      allow write: if isAdmin() || isSuperUser() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Tithis collection - public read access, permission-based write access
    match /tithis/{tithiId} {
      // Anyone can read tithis (calendar is shown on public landing page)
      allow read: if true;
      // Admins or users with manageTithis permission can create/update/delete tithis
      allow write: if hasPermission('manageTithis');
    }

    // Home cards collection - for managing Block1 feature cards
    match /homeCards/{cardId} {
      // Anyone can read published cards (for public display on landing page)
      allow read: if resource.data.published == true;
      // Admins can always read/write
      // Super Users with manageHomeCards permission can read/write
      allow read, write: if hasPermission('manageHomeCards');
    }

    // Calendar Events collection - for calendar-specific events with role-based visibility
    match /calendarEvents/{eventId} {
      // Public events visible to everyone
      // Private events visible only to creator and admins
      // Allow reading if public, if creator, if admin, or if user has manageEvents permission
      allow read: if resource.data.isPublic == true ||
             (isAuthenticated() && resource.data.createdBy == request.auth.uid) ||
             isAdmin() ||
             hasPermission('manageEvents');
      
      // Admins and users with manageEvents permission can create any event
      // Regular users can create their own private events
      allow create: if hasPermission('manageEvents') || 
                       (isAuthenticated() && request.resource.data.createdBy == request.auth.uid);
      
      // Users can update/delete only their own events
      // Admins and users with manageEvents permission can modify any
      allow update, delete: if hasPermission('manageEvents') || 
                               (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    // adminList controls which users are considered admins (bootstrap via console)
    match /adminList/{adminId} {
      // Allow a user to read their own admin doc, or allow admins to read any
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      // Only admins can create/update/delete adminList entries
      allow create, update, delete: if isAdmin();
    }

    // User invitations - for pending user setup
    match /userInvitations/{emailId} {
      // Admins can create/read/update/delete invitations
      allow create, read, update, delete: if isAdmin();

      // Allow the invited user (authenticated) to read/update their own invitation
      // Compare the authenticated user's email with the `email` field stored in the
      // invitation document to avoid relying on unsupported string functions.
      // Allow if the stored email matches the authenticated email, or if a stored
      // lowercased email field matches (covers invitations created with different case)
      allow read, update: if isAuthenticated() && (
             resource.data.email == request.auth.token.email ||
             (resource.data.emailLower != null && resource.data.emailLower == request.auth.token.email)
            );
    }

    // Site settings - for managing global settings like Block 1 visibility
    match /siteSettings/{settingId} {
      // Anyone can read settings (for public display preferences)
      allow read: if true;
      // Only admins can modify settings
      allow write: if isAdmin();
    }

    // Nepali calendar years - for managing calendar configuration (admin only)
    match /nepaliCalendarYears/{year} {
      // Only admins and users with manageCalendar permission can read/write
      allow read, write: if hasPermission('manageCalendar');
    }

    // Trees collection - backing the embedded visual tree builder
    match /trees/{treeId} {
      // A tree is owned by ownerUid; admins can manage all trees.
      allow read, write: if isAdmin() || (
        isAuthenticated() && (
          // For create, use the requested ownerUid; for existing trees, use stored ownerUid
          (request.resource != null && request.resource.data.ownerUid == request.auth.uid) ||
          (resource != null && resource.data.ownerUid == request.auth.uid)
        )
      );

      // Members subcollection for a given tree
      match /members/{memberId} {
        allow read, write: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == request.auth.uid
        );
      }

      // Relationships subcollection for a given tree
      match /relationships/{relationshipId} {
        allow read, write: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == request.auth.uid
        );
      }

      // Marriage points subcollection for a given tree
      match /marriagePoints/{marriagePointId} {
        allow read, write: if isAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == request.auth.uid
        );
      }
    }
  }
}