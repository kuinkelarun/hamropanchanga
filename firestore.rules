rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions — declared before use to avoid compilation issues
    function isAuthenticated() {
      return request.auth != null;
    }

    // Some auth providers / tenants may not populate request.auth.token.email.
    // Try multiple sources in order:
    // 1) request.auth.token.email
    // 2) request.auth.token.firebase.identities.email[0]
    // 3) /users/{uid}.email
    //
    // IMPORTANT: Avoid using the /users fallback inside LIST queries.
    // LIST (collection queries) can fail with PERMISSION_DENIED if rules perform
    // too many get()/exists() calls across matched documents.
    function userEmailLower() {
      return !isAuthenticated() ? null :
        (
          request.auth.token.email != null ? request.auth.token.email.lower() :
          (
            (request.auth.token.firebase != null &&
             request.auth.token.firebase.identities != null &&
             request.auth.token.firebase.identities.email != null &&
             request.auth.token.firebase.identities.email.size() > 0
            ) ? request.auth.token.firebase.identities.email[0].lower() :
            (
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email != null
              ) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() : null
            )
          )
        );
    }

    // Token-only email resolver (NO get()/exists()).
    // Use this in LIST rules to keep queries reliable.
    function userEmailLowerFromToken() {
      return !isAuthenticated() ? null :
        (
          request.auth.token.email != null ? request.auth.token.email.lower() :
          (
            (request.auth.token.firebase != null &&
             request.auth.token.firebase.identities != null &&
             request.auth.token.firebase.identities.email != null &&
             request.auth.token.firebase.identities.email.size() > 0
            ) ? request.auth.token.firebase.identities.email[0].lower() : null
          )
        );
    }

    // Admin if auth token has admin claim OR there exists an adminList document for their uid
    // OR user document has role == 'admin'
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminList/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Check if user is a Super User
    // Note: used below in permission checks to ensure the linter marks it as used.
    function isSuperUser() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superuser';
    }

    // Check if user has a specific permission
    function hasPermission(permission) {
      return isAuthenticated() && (
        isAdmin() || // Admins have all permissions
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true)
      );
    }

    // Owner check for documents that store a `userId` field
    function isOwnerOfUserId(userId) {
      return isAuthenticated() && userId == request.auth.uid;
    }

    // Tree read access check (used for calendarEvents and shared tree access)
    // Returns true if user owns the tree OR if tree is shared with user (any permission level)
    function isTreeOwner(treeId) {
      let email = userEmailLower();
      return isAuthenticated() &&
        treeId != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)) &&
        (get(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == request.auth.uid ||
         (get(/databases/$(database)/documents/trees/$(treeId)).data.sharedWith != null &&
          email != null &&
          email in get(/databases/$(database)/documents/trees/$(treeId)).data.sharedWith)
        );
    }
    
    // Tree edit access check - only owner or users with 'edit' permission can modify
    function hasTreeEditPermission(treeId) {
      let email = userEmailLower();
      return isAuthenticated() &&
        treeId != null &&
        exists(/databases/$(database)/documents/trees/$(treeId)) &&
        (get(/databases/$(database)/documents/trees/$(treeId)).data.ownerUid == request.auth.uid ||
         (get(/databases/$(database)/documents/trees/$(treeId)).data.sharedWith != null &&
          email != null &&
          email in get(/databases/$(database)/documents/trees/$(treeId)).data.sharedWith &&
          get(/databases/$(database)/documents/trees/$(treeId)).data.sharedWith[email].permission == 'edit'));
    }

    match /customers/{customerId} {
      // Customers can be accessed by their owner or by admins
      // Uses nested resource access for creates vs. reads/updates
      allow read, write: if isAdmin() || (
        isAuthenticated() && (
        // create uses request.resource, reads/updates use resource
        (request.resource != null && isOwnerOfUserId(request.resource.data.userId)) ||
        (resource != null && isOwnerOfUserId(resource.data.userId))
      )
      );

      // Allow access to familyMembers subcollection if user owns the parent customer document
      match /familyMembers/{memberId} {
        allow read, write: if isAdmin() || (
          isAuthenticated() && 
          get(/databases/$(database)/documents/customers/$(customerId)).data.userId == request.auth.uid
        );
      }
    }

    match /users/{userId} {
      // Users can read their own document
      // Admins and Super Users can read/write any user document (for user management)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isSuperUser());
      // Allow users to create/update their own document (for invitation processing)
      // Admins can modify any user document (for user management)
      allow write: if isAdmin() || isSuperUser() || (isAuthenticated() && request.auth.uid == userId);
    }

    // API keys collection — admin write only, no public read (keys are hashed here)
    match /apiKeys/{keyId} {
      allow read, write: if isAdmin();
    }

    // API key requests — authenticated users submit requests; admins approve
    match /apiKeyRequests/{requestId} {
      // Any signed-in user can create a request (must match their own UID)
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Users can read their own request; admins can read all
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // Admins can update any field; users can only flip rawKeyAcknowledged
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rawKeyAcknowledged'])
      );
      allow delete: if isAdmin();
    }

    // Tithis collection - public read access, permission-based write access
    match /tithis/{tithiId} {
      // Anyone can read tithis (calendar is shown on public landing page)
      allow read: if true;
      // Admins or users with manageTithis permission can create/update/delete tithis
      allow write: if hasPermission('manageTithis');
    }

    // Home cards collection - for managing Block1 feature cards
    match /homeCards/{cardId} {
      // Anyone can read published cards (for public display on landing page)
      allow read: if resource.data.published == true;
      // Admins can always read/write
      // Super Users with manageHomeCards permission can read/write
      allow read, write: if hasPermission('manageHomeCards');
    }

    // Calendar Events collection - for calendar-specific events with role-based visibility
    match /calendarEvents/{eventId} {
      // Public events visible to everyone
      // Private events visible only to creator and admins
          // Allow reading if public, if creator, if tree owner (tree-linked events), if admin, or if user has manageEvents permission
      allow read: if resource.data.isPublic == true ||
             (isAuthenticated() && resource.data.createdBy == request.auth.uid) ||
            (resource.data.treeId != null && isTreeOwner(resource.data.treeId)) ||
             isAdmin() ||
             hasPermission('manageEvents');
      
      // Admins and users with manageEvents permission can create any event
      // Regular users can create their own private events
      allow create: if hasPermission('manageEvents') || 
                       (isAuthenticated() && request.resource.data.createdBy == request.auth.uid);
      
      // Users can update/delete only their own events
      // Tree-linked events can be updated/deleted only by tree owner or those with edit permission
      // Admins and users with manageEvents permission can modify any
      allow update, delete: if hasPermission('manageEvents') || 
                               (isAuthenticated() && resource.data.createdBy == request.auth.uid) ||
                               (resource.data.treeId != null && hasTreeEditPermission(resource.data.treeId));
    }

    // adminList controls which users are considered admins (bootstrap via console)
    match /adminList/{adminId} {
      // Allow a user to read their own admin doc, or allow admins to read any
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      // Only admins can create/update/delete adminList entries
      allow create, update, delete: if isAdmin();
    }

    // User invitations - for pending user setup
    match /userInvitations/{emailId} {
      // Admins can create/read/update/delete invitations
      allow create, read, update, delete: if isAdmin();

      // Allow an authenticated user to GET their own invitation doc by document ID.
      // This avoids permission-denied when the invitation doesn't exist (resource == null).
      // Note: This does not enable listing invitations.
      allow get: if isAuthenticated() && emailId == request.auth.token.email;

      // Allow the invited user (authenticated) to read/update their own invitation
      // Compare the authenticated user's email with the `email` field stored in the
      // invitation document to avoid relying on unsupported string functions.
      // Allow if the stored email matches the authenticated email, or if a stored
      // lowercased email field matches (covers invitations created with different case)
      allow read, update: if isAuthenticated() && (
             resource.data.email == request.auth.token.email ||
             (resource.data.emailLower != null && resource.data.emailLower == request.auth.token.email)
            );
    }

    // Site settings - for managing global settings like Block 1 visibility
    match /siteSettings/{settingId} {
      // Anyone can read settings (for public display preferences)
      allow read: if true;
      // Only admins can modify settings
      allow write: if isAdmin();
    }

    // Nepali calendar years - for managing calendar configuration (admin only)
    match /nepaliCalendarYears/{year} {
      // Only admins and users with manageCalendar permission can read/write
      allow read, write: if hasPermission('manageCalendar');
    }

    // Trees collection - backing the embedded visual tree builder
    match /trees/{treeId} {
      // A tree is owned by ownerUid; admins can manage all trees.
      // Super users and regular users can create/manage their own trees.
      // Admins can update any tree (including sharedWith field for sharing)
      // Users can read trees shared with them.
      // Split GET vs LIST:
      // - GET can use userEmailLower() (includes /users fallback)
      // - LIST must avoid get()/exists() to prevent query-wide PERMISSION_DENIED
      allow get: if isAdmin() ||
        isSuperUser() || // Super users can manage all trees (for bulk upload functionality)
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid) ||
        (isAuthenticated() && userEmailLower() != null &&
         resource.data.sharedWith != null &&
         userEmailLower() in resource.data.sharedWith);

      allow list: if isAdmin() || 
        isSuperUser() ||
        (isAuthenticated() && (
          // Allow listing own trees
          resource.data.ownerUid == request.auth.uid ||
          // Allow listing trees shared with the user (check array, not map, for LIST queries)
          (
            resource.data.sharedWithEmails != null &&
            userEmailLowerFromToken() != null &&
            userEmailLowerFromToken() in resource.data.sharedWithEmails
          )
        ));
      
      // Write access: owner can do anything, admin can update sharedWith field
      allow create: if isAdmin() ||
        isSuperUser() ||
        (isAuthenticated() && request.resource.data.ownerUid == request.auth.uid);
      
      allow update: if isAdmin() || // Admin can update any tree (e.g., for sharing)
        isSuperUser() ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      
      allow delete: if isAdmin() ||
        isSuperUser() ||
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      // Members subcollection for a given tree
      match /members/{memberId} {
        // Read access: owner, admin, super user, or shared user
        allow read: if isAdmin() || 
          isSuperUser() ||
          (isAuthenticated() && isTreeOwner(treeId));
        
        // Write access: owner, admin, super user, or shared user with edit permission
        allow write: if isAdmin() || 
          isSuperUser() ||
          (isAuthenticated() && hasTreeEditPermission(treeId));
      }

      // Relationships subcollection for a given tree
      match /relationships/{relationshipId} {
        // Read access: owner, admin, super user, or shared user
        allow read: if isAdmin() || 
          isSuperUser() ||
          (isAuthenticated() && isTreeOwner(treeId));
        
        // Write access: owner, admin, super user, or shared user with edit permission
        allow write: if isAdmin() || 
          isSuperUser() ||
          (isAuthenticated() && hasTreeEditPermission(treeId));
      }

      // Marriage points subcollection for a given tree
      match /marriagePoints/{marriagePointId} {
        // Read access: owner, admin, super user, or shared user
        allow read: if isAdmin() || 
          isSuperUser() ||
          (isAuthenticated() && isTreeOwner(treeId));
        
        // Write access: owner, admin, super user, or shared user with edit permission
        allow write: if isAdmin() || 
          isSuperUser() ||
          (isAuthenticated() && hasTreeEditPermission(treeId));
      }
    }

    // Tree sharing invitations via WhatsApp
    // Created by the shareTreeWithWhatsApp Cloud Function (Admin SDK bypasses rules).
    // Recipient can read their own invitation by ID or by matching phone/email.
    // Claiming is handled by the claimInvitation Cloud Function (Admin SDK).
    match /invitations/{invitationId} {
      // Sender or admin can read any invitation
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.fromUid == request.auth.uid);

      // Recipient can read if their email matches hintEmail or they were linked by phone
      allow read: if isAuthenticated() && (
        (resource.data.hintEmail != null && resource.data.hintEmail == userEmailLower()) ||
        (resource.data.claimedByUid != null && resource.data.claimedByUid == request.auth.uid)
      );

      // No client-side writes — all mutations go through Cloud Functions (Admin SDK)
      allow create, update, delete: if false;
    }

    // Encrypted per-user LLM credentials — managed exclusively by the chat backend
    // via the Firebase Admin SDK (which bypasses these rules). Browser clients must
    // never be able to read or write this collection directly.
    match /userLlmConfigs/{uid} {
      allow read, write: if false;
    }
  }
}